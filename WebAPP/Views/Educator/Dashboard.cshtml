@model EducatorDashboardViewModel
@{ ViewData["Title"] = "Статистика"; }

@functions {
    static string ScoreClass(decimal s) => s >= 8 ? "score-high" : s >= 5 ? "score-medium" : "score-low";
    static string ScoreBg(decimal s)    => s >= 8 ? "#27ae60" : s >= 5 ? "#f39c12" : "#e74c3c";
}

<!-- Фильтры -->
<div class="card stat-card mb-4">
    <div class="card-body py-2">
        <form method="get" asp-action="Dashboard" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label form-label-sm mb-1">Период с</label>
                <input type="date" name="dateFrom" class="form-control form-control-sm"
                       value="@Model.DateFrom" />
            </div>
            <div class="col-auto">
                <label class="form-label form-label-sm mb-1">по</label>
                <input type="date" name="dateTo" class="form-control form-control-sm"
                       value="@Model.DateTo" />
            </div>
            <div class="col-auto">
                <label class="form-label form-label-sm mb-1">Этаж</label>
                <select name="floor" class="form-select form-select-sm" style="min-width:90px">
                    <option value="">Все</option>
                    @foreach (var f in Model.Floors)
                    {
                        if (Model.SelectedFloor == f)
                        { <option value="@f" selected>@f этаж</option> }
                        else
                        { <option value="@f">@f этаж</option> }
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label form-label-sm mb-1">Блок</label>
                <select name="blockId" class="form-select form-select-sm" style="min-width:130px">
                    <option value="">Все блоки</option>
                    @foreach (var b in Model.Blocks.OrderBy(x => x.Floor).ThenBy(x => x.BlockNumber))
                    {
                        if (Model.SelectedBlockId == b.Id)
                        { <option value="@b.Id" selected>@b.BlockNumber (эт. @b.Floor)</option> }
                        else
                        { <option value="@b.Id">@b.BlockNumber (эт. @b.Floor)</option> }
                    }
                </select>
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-funnel me-1"></i>Применить
                </button>
                @if (Model.IsFiltered)
                {
                    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-x-circle me-1"></i>Сбросить
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (Model.IsFiltered)
{
    <div class="alert alert-info d-flex align-items-center gap-2 py-2 mb-3" role="alert">
        <i class="bi bi-funnel-fill"></i>
        <span>
            Отображается статистика по фильтру:
            @if (!string.IsNullOrEmpty(Model.DateFrom) || !string.IsNullOrEmpty(Model.DateTo))
            { <strong>период @(Model.DateFrom ?? "…") — @(Model.DateTo ?? "…")</strong><text>; </text> }
            @if (Model.SelectedFloor.HasValue)
            { <strong>@Model.SelectedFloor этаж</strong><text>; </text> }
            @if (Model.SelectedBlockId.HasValue)
            { <strong>блок @(Model.Blocks.FirstOrDefault(b => b.Id == Model.SelectedBlockId)?.BlockNumber ?? "")</strong> }
        </span>
    </div>
}

<!-- Статистические карточки -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card border-start border-4 border-primary">
            <div class="card-body">
                <div class="stat-number text-primary">@Model.Stats.AverageScore.ToString("F1")</div>
                <div class="stat-label">Средний балл общежития</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card border-start border-4 border-success">
            <div class="card-body">
                <div class="stat-number text-success">@Model.Stats.TotalBlocks</div>
                <div class="stat-label">Всего блоков</div>
            </div>
        </div>
    </div>
    @foreach (var floor in Model.Stats.Floors)
    {
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card border-start border-4 border-warning">
                <div class="card-body">
                    <div class="stat-number text-warning">@floor.AverageScore.ToString("F1")</div>
                    <div class="stat-label">Средний балл — @floor.Floor этаж</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-4 mb-4">
    <!-- График баллов по блокам -->
    <div class="col-lg-7">
        <div class="card stat-card h-100">
            <div class="card-header bg-white fw-semibold border-0 pt-3">
                <i class="bi bi-bar-chart-fill text-primary me-2"></i>Текущие оценки блоков
            </div>
            <div class="card-body">
                <canvas id="blocksChart" height="200"></canvas>
            </div>
        </div>
    </div>

    <!-- Лучшие и худшие -->
    <div class="col-lg-5">
        <div class="card stat-card mb-3">
            <div class="card-header bg-white fw-semibold border-0 pt-3 text-success">
                <i class="bi bi-trophy-fill me-2"></i>Лучшие блоки
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var b in Model.BestBlocks)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>Блок @b.BlockNumber</span>
                        <span class="score-badge @ScoreClass(b.Score)">@b.Score.ToString("F1")</span>
                    </li>
                }
                @if (!Model.BestBlocks.Any())
                {
                    <li class="list-group-item text-muted small">
                        Нет данных за текущую неделю.
                        <form method="post" asp-action="RecalculateStats" class="d-inline ms-1">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link btn-sm p-0 text-primary">Пересчитать</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
        <div class="card stat-card">
            <div class="card-header bg-white fw-semibold border-0 pt-3 text-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Требуют внимания
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var b in Model.WorstBlocks)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>Блок @b.BlockNumber</span>
                        <span class="score-badge @ScoreClass(b.Score)">@b.Score.ToString("F1")</span>
                    </li>
                }
                @if (!Model.WorstBlocks.Any())
                {
                    <li class="list-group-item text-muted small">Нет данных</li>
                }
            </ul>
        </div>
    </div>
</div>

<!-- Последние проверки -->
<div class="table-card">
    <div class="p-3 border-bottom fw-semibold d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-clipboard-check me-2 text-primary"></i>
            @(Model.IsFiltered ? "Проверки по фильтру" : "Последние проверки")
            <span class="badge bg-secondary ms-1">@Model.RecentInspections.Count</span>
        </span>
        <a asp-controller="Educator" asp-action="Inspections"
           asp-route-dateFrom="@Model.DateFrom" asp-route-dateTo="@Model.DateTo"
           asp-route-blockId="@Model.SelectedBlockId" asp-route-floor="@Model.SelectedFloor"
           class="btn btn-sm btn-outline-primary">
            Все проверки <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Дата</th>
                <th>Блок</th>
                <th>Зона</th>
                <th>Инспектор</th>
                <th>Оценка</th>
                <th>Комментарий</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model.RecentInspections)
            {
                <tr>
                    <td>@i.InspectionDate.ToString("dd.MM.yyyy")</td>
                    <td><span class="badge bg-secondary">@i.BlockNumber</span></td>
                    <td>@i.ZoneName</td>
                    <td>@i.InspectorName</td>
                    <td><span class="score-badge @ScoreClass(i.Score)">@i.Score / 10</span></td>
                    <td class="text-muted small">@i.Comment</td>
                </tr>
            }
            @if (!Model.RecentInspections.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-3">Нет данных</td></tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    const allScores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Stats.Floors.SelectMany(f => f.BlockScores)
            .Select(b => new { label = "Блок " + b.BlockNumber, score = (double)b.Score })
            .ToList()));

    if (allScores.length > 0) {
        new Chart(document.getElementById('blocksChart'), {
            type: 'bar',
            data: {
                labels: allScores.map(x => x.label),
                datasets: [{
                    label: 'Оценка',
                    data: allScores.map(x => x.score),
                    backgroundColor: allScores.map(x => x.score >= 8 ? '#27ae60' : x.score >= 5 ? '#f39c12' : '#e74c3c'),
                    borderRadius: 6,
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { min: 0, max: 10, grid: { color: '#f0f0f0' } },
                    x: { grid: { display: false } }
                }
            }
        });
    } else {
        document.getElementById('blocksChart').insertAdjacentHTML('beforebegin',
            '<p class="text-center text-muted py-4">Нет данных за текущую неделю. ' +
            '<form method="post" action="/Educator/RecalculateStats" style="display:inline">' +
            '<input type="hidden" name="__RequestVerificationToken" value="' + document.querySelector('[name=__RequestVerificationToken]')?.value + '">' +
            '<button type="submit" class="btn btn-link p-0 text-primary">Пересчитать</button></form></p>');
        document.getElementById('blocksChart').style.display = 'none';
    }
</script>
}
