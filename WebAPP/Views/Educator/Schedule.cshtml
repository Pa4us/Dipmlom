@model InspectionScheduleViewModel
@{ ViewData["Title"] = "Расписание проверок"; }

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="form-card">
            <h6 class="fw-bold mb-1">
                <i class="bi bi-calendar-week-fill text-primary me-2"></i>День проведения проверок
            </h6>
            <p class="text-muted small mb-4">
                Выберите один день недели. Система автоматически определит все даты этого дня в текущем месяце —
                именно в эти дни инспекторам будет разрешено проводить проверки блоков.
            </p>

            <form method="post">
                <div class="d-flex flex-column gap-2 mb-4">
                    @for (int d = 0; d < 7; d++)
                    {
                        var isSelected = Model.SelectedDay == d;
                        var isWeekend  = d >= 5;
                        var btnClass   = isSelected ? "btn-primary" : (isWeekend ? "btn-outline-danger" : "btn-outline-secondary");
                        <div>
                            <input type="radio" class="btn-check" name="selectedDay"
                                   id="day@(d)" value="@d" autocomplete="off"
                                   @(isSelected ? "checked" : "") />
                            <label class="btn @btnClass w-100 text-start py-2 px-3" for="day@(d)">
                                <i class="bi bi-@(d+1)-circle me-2 @(isWeekend ? "" : "")"></i>
                                @WebAPP.Services.InspectionScheduleService.DayNames[d]
                                @if (isWeekend)
                                {
                                    <span class="badge bg-danger ms-2">вых.</span>
                                }
                            </label>
                        </div>
                    }
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-save me-1"></i>Сохранить расписание
                </button>
            </form>
        </div>

        <!-- Даты текущего месяца -->
        <div class="card stat-card mt-3">
            <div class="card-body">
                <div class="fw-semibold mb-2">
                    <i class="bi bi-calendar3 me-1 text-primary"></i>
                    Даты проверок в @DateTime.Today.ToString("MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))
                </div>
                @if (Model.MonthDates.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        @foreach (var date in Model.MonthDates)
                        {
                            var isPast   = date < DateOnly.FromDateTime(DateTime.Today);
                            var isToday  = date == DateOnly.FromDateTime(DateTime.Today);
                            var badgeCss = isToday ? "bg-success" : isPast ? "bg-secondary" : "bg-primary";
                            <span class="badge @badgeCss" style="font-size:.9rem;padding:6px 12px">
                                @if (isToday) { <i class="bi bi-check-circle me-1"></i> }
                                @date.ToString("dd.MM.yyyy")
                                @if (isToday) { <span class="ms-1">(сегодня)</span> }
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="small text-muted mt-1">Нет дат в текущем месяце</div>
                }

                <div class="d-flex align-items-center gap-2 mt-3 pt-2 border-top">
                    <span class="text-muted small">Сегодня (@WebAPP.Services.InspectionScheduleService.DayNames[(int)DateTime.Today.DayOfWeek == 0 ? 6 : (int)DateTime.Today.DayOfWeek - 1]):</span>
                    @{
                        var dow = (int)DateTime.Today.DayOfWeek;
                        var normalizedToday = dow == 0 ? 6 : dow - 1;
                        var isAllowed = normalizedToday == Model.SelectedDay;
                    }
                    @if (isAllowed)
                    {
                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Проверки разрешены</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary"><i class="bi bi-lock me-1"></i>Проверки не проводятся</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

